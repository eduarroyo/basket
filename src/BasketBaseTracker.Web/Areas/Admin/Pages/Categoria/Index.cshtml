@page
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Categorias
@model IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<h1>Categorías</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Nueva categoría</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Categorias[0].Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Categorias[0].Orden)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Categorias)
{
        <tr>
            <td>@Html.DisplayFor(m => item.Nombre)</td>
            <td>@Html.DisplayFor(m => item.Orden)</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
