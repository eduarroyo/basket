@page
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Temporadas
@model IndexModel
@{
    ViewData["Title"] = "Temporadas";
}

<h1>Temporadas</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Nueva temporada</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Temporadas[0].Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Temporadas[0].FechaInicio)</th>
            <th>@Html.DisplayNameFor(m => m.Temporadas[0].FechaFin)</th>
            <th>@Html.DisplayNameFor(m => m.Temporadas[0].Estado)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Temporadas)
{
        <tr>
            <td>@Html.DisplayFor(m => item.Nombre)</td>
            <td>@item.FechaInicio.ToString("d")</td>
            <td>@item.FechaFin.ToString("d")</td>
            <td>@Html.DisplayFor(m => item.Estado)</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
