@page "{partidoId:int}"
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.PartidosParciales
@model CreateModel
@{
    ViewData["Title"] = "Nuevo parcial";
}

<h1>Nuevo parcial — @Model.Partido.EquipoLocal.Nombre vs. @Model.Partido.EquipoVisitante.Nombre</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PartidoParcial.NumeroPeriodo" class="control-label"></label>
                <input asp-for="PartidoParcial.NumeroPeriodo" class="form-control" />
                <span asp-validation-for="PartidoParcial.NumeroPeriodo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PartidoParcial.PuntosLocal" class="control-label"></label>
                <input asp-for="PartidoParcial.PuntosLocal" class="form-control" />
                <span asp-validation-for="PartidoParcial.PuntosLocal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PartidoParcial.PuntosVisitante" class="control-label"></label>
                <input asp-for="PartidoParcial.PuntosVisitante" class="form-control" />
                <span asp-validation-for="PartidoParcial.PuntosVisitante" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Crear" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index" asp-route-partidoId="@Model.Partido.Id">Volver a los parciales</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
