@page "{id:int}"
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Resultados
@using BasketBaseTracker.Web.Data.Entities
@model EditModel
@{
    ViewData["Title"] = "Resultado";
}

<h1>Resultado — @Model.PartidoContexto.EquipoLocal.Nombre vs. @Model.PartidoContexto.EquipoVisitante.Nombre</h1>
<hr />
<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Partido.Id" />
            <input type="hidden" asp-for="Partido.RowVersion" />
            <div class="form-group">
                <label asp-for="Partido.Estado" class="control-label"></label>
                <select asp-for="Partido.Estado" id="estadoSelect" asp-items="Html.GetEnumSelectList<PartidoEstado>()" class="form-control"></select>
                <span asp-validation-for="Partido.Estado" class="text-danger"></span>
            </div>

            <div id="grupoMarcador">
                <div class="form-group">
                    <label asp-for="Partido.PuntosLocal" class="control-label"></label>
                    <input asp-for="Partido.PuntosLocal" class="form-control" />
                    <span asp-validation-for="Partido.PuntosLocal" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Partido.PuntosVisitante" class="control-label"></label>
                    <input asp-for="Partido.PuntosVisitante" class="form-control" />
                    <span asp-validation-for="Partido.PuntosVisitante" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <button type="button" id="btnTecnicaLocal" class="btn btn-outline-secondary btn-sm">Victoria técnica local (2-0)</button>
                    <button type="button" id="btnTecnicaVisitante" class="btn btn-outline-secondary btn-sm">Victoria técnica visitante (0-2)</button>
                    <button type="button" id="btnCalcularParciales" class="btn btn-outline-secondary btn-sm"
                            data-suma-local="@Model.SumaPuntosLocal" data-suma-visitante="@Model.SumaPuntosVisitante"
                            disabled="@(Model.TieneParciales ? null : "disabled")">
                        Calcular desde los parciales
                    </button>
                </div>
            </div>

            <div id="grupoResolucion">
                <div class="form-group">
                    <label asp-for="Partido.MotivoResolucion" class="control-label"></label>
                    <select asp-for="Partido.MotivoResolucion" asp-items="Html.GetEnumSelectList<MotivoResolucion>()" class="form-control">
                        <option value="">-- Sin motivo --</option>
                    </select>
                    <span asp-validation-for="Partido.MotivoResolucion" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Partido.EquipoGanadorResolucionId" class="control-label"></label>
                    <select asp-for="Partido.EquipoGanadorResolucionId" id="ganadorSelect" class="form-control" asp-items="ViewBag.EquipoGanadorResolucionId"
                            data-equipo-local-id="@Model.PartidoContexto.EquipoLocalId" data-equipo-visitante-id="@Model.PartidoContexto.EquipoVisitanteId">
                        <option value="">-- Sin ganador --</option>
                    </select>
                    <span asp-validation-for="Partido.EquipoGanadorResolucionId" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Partido.Observaciones" class="control-label"></label>
                <textarea asp-for="Partido.Observaciones" class="form-control"></textarea>
                <span asp-validation-for="Partido.Observaciones" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-area="Admin" asp-page="/PartidoParcial/Index" asp-route-partidoId="@Model.Partido.Id">Parciales</a> |
    <a asp-area="Admin" asp-page="/Partido/Index" asp-route-jornadaId="@Model.PartidoContexto.JornadaId">Volver a los partidos</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var estadoSelect = document.getElementById('estadoSelect');
            var grupoMarcador = document.getElementById('grupoMarcador');
            var grupoResolucion = document.getElementById('grupoResolucion');
            var ganadorSelect = document.getElementById('ganadorSelect');
            var puntosLocal = document.getElementById('Partido_PuntosLocal');
            var puntosVisitante = document.getElementById('Partido_PuntosVisitante');
            var btnTecnicaLocal = document.getElementById('btnTecnicaLocal');
            var btnTecnicaVisitante = document.getElementById('btnTecnicaVisitante');
            var btnCalcularParciales = document.getElementById('btnCalcularParciales');

            // El valor de <option> de Html.GetEnumSelectList es el entero
            // subyacente del enum ("1", no "Jugado"), así que comparar por
            // nombre exige leer el texto de la opción seleccionada, no
            // estadoSelect.value — bug preexistente encontrado en BAS-15
            // (grupoMarcador nunca llegaba a mostrarse).
            function estadoSeleccionadoTexto() {
                return estadoSelect.options[estadoSelect.selectedIndex].text;
            }

            function actualizarVisibilidad() {
                var estado = estadoSeleccionadoTexto();
                var requiereMarcador = estado === 'Jugado' || estado === 'Resuelto';
                grupoMarcador.style.display = requiereMarcador ? '' : 'none';
                grupoResolucion.style.display = estado === 'Resuelto' ? '' : 'none';
            }

            estadoSelect.addEventListener('change', actualizarVisibilidad);
            actualizarVisibilidad();

            // Los botones de marcador fijan también el ganador cuando el resultado
            // lo determina; cambiar el ganador a mano después ya NO reescribe el
            // marcador (relación de un solo sentido — BAS-15, a diferencia del
            // autorrelleno inverso que había antes).
            function rellenarMarcador(local, visitante, ganadorId) {
                puntosLocal.value = local;
                puntosVisitante.value = visitante;
                ganadorSelect.value = ganadorId || '';
            }

            btnTecnicaLocal.addEventListener('click', function () {
                rellenarMarcador(2, 0, ganadorSelect.dataset.equipoLocalId);
            });

            btnTecnicaVisitante.addEventListener('click', function () {
                rellenarMarcador(0, 2, ganadorSelect.dataset.equipoVisitanteId);
            });

            btnCalcularParciales.addEventListener('click', function () {
                var sumaLocal = parseInt(this.dataset.sumaLocal, 10);
                var sumaVisitante = parseInt(this.dataset.sumaVisitante, 10);
                var ganadorId = null;
                if (sumaLocal > sumaVisitante) {
                    ganadorId = ganadorSelect.dataset.equipoLocalId;
                } else if (sumaVisitante > sumaLocal) {
                    ganadorId = ganadorSelect.dataset.equipoVisitanteId;
                }
                rellenarMarcador(sumaLocal, sumaVisitante, ganadorId);
            });
        })();
    </script>
}
