@page
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Clubes
@model IndexModel
@{
    ViewData["Title"] = "Clubes";
}

<h1>Clubes</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Nuevo club</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Clubes[0].Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Clubes[0].Municipio)</th>
            <th>@Html.DisplayNameFor(m => m.Clubes[0].FechaAlta)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Clubes)
{
        <tr>
            <td>@Html.DisplayFor(m => item.Nombre)</td>
            <td>@Html.DisplayFor(m => item.Municipio)</td>
            <td>@item.FechaAlta.ToString("d")</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Editar</a>
            </td>
        </tr>
}
    </tbody>
</table>
