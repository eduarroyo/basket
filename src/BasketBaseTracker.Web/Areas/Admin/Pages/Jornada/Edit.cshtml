@page "{id:int}"
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Jornadas
@model EditModel
@{
    ViewData["Title"] = "Editar jornada";
}

<h1>Editar jornada — @Model.Competicion.Temporada.Nombre — @Model.Competicion.Categoria.Nombre</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Jornada.Id" />
            <input type="hidden" asp-for="Jornada.CompeticionId" />
            <div class="form-group">
                <label asp-for="Jornada.Numero" class="control-label"></label>
                <input asp-for="Jornada.Numero" class="form-control" />
                <span asp-validation-for="Jornada.Numero" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Jornada.Etiqueta" class="control-label"></label>
                <input asp-for="Jornada.Etiqueta" class="form-control" />
                <span asp-validation-for="Jornada.Etiqueta" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Jornada.CuentaParaClasificacion" /> @Html.DisplayNameFor(m => m.Jornada.CuentaParaClasificacion)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index" asp-route-competicionId="@Model.Competicion.Id">Volver al calendario</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
