@page "{id:int}"
@namespace BasketBaseTracker.Web.Areas.Admin.Pages.Partidos
@model EditModel
@{
    ViewData["Title"] = "Editar partido";
}

<h1>Editar partido — @(Model.Jornada.Etiqueta ?? $"Jornada {Model.Jornada.Numero}")</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Partido.Id" />
            <div class="form-group">
                <label asp-for="Partido.EquipoLocalId" class="control-label"></label>
                <select asp-for="Partido.EquipoLocalId" class="form-control" asp-items="ViewBag.EquipoId"></select>
                <span asp-validation-for="Partido.EquipoLocalId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Partido.EquipoVisitanteId" class="control-label"></label>
                <select asp-for="Partido.EquipoVisitanteId" class="form-control" asp-items="ViewBag.EquipoId"></select>
                <span asp-validation-for="Partido.EquipoVisitanteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Partido.SedeId" class="control-label"></label>
                <select asp-for="Partido.SedeId" class="form-control" asp-items="ViewBag.SedeId">
                    <option value="">-- Sede habitual del equipo local --</option>
                </select>
                <span asp-validation-for="Partido.SedeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Partido.FechaHora" class="control-label"></label>
                <input asp-for="Partido.FechaHora" type="datetime-local" class="form-control" />
                <span asp-validation-for="Partido.FechaHora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index" asp-route-jornadaId="@Model.Jornada.Id">Volver a los partidos</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
