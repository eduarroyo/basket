@page
@using BasketBaseTracker.Web.Data.Entities
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">BasketBaseTracker</h1>
    <p>Seguimiento de la competición de baloncesto base de la provincia de Sevilla.</p>
</div>

<h2>Temporadas</h2>
<ul class="list-group">
@foreach (var temporada in Model.Temporadas)
{
        <li class="list-group-item">
            <a asp-page="/Temporadas/Competiciones" asp-route-id="@temporada.Id">@temporada.Nombre</a>
            @if (temporada.Estado == TemporadaEstado.EnCurso)
            {
                <span class="badge bg-primary">Actual</span>
            }
        </li>
}
</ul>
